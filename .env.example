# Vite client-side environment variables
# Copy this file to .env and fill in your values

# CarImages API key for 3D model viewer
# The app has a default key, but you can override it here
VITE_CARIMAGES_API_KEY=

# Motomarks publishable key (pk_). Safe in the browser. Get one at https://motomarks.io
VITE_MOTOMARKS_KEY=

# Motomarks secret key (sk_). Server/scripts only — never prefix with VITE_.
# Put this in .env.local and run: MOTOMARKS_SECRET_KEY=sk_... node scripts/fetch-motomarks-brands.mjs
# Vite client-side environment variables
# Copy this file to .env and fill in your values

# CarImages API key for 3D model viewer
# The app has a default key, but you can override it here
VITE_CARIMAGES_API_KEY=

